# Application & Environment Settings
ENVIRONMENT=development
DEBUG=true
PORT=8000
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_64_CHAR_SECRET_KEY

# Google Cloud Platform (GCP)
GCP_PROJECT_ID=carbon1-499909
GCP_LOCATION=asia-south1
GEMINI_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004
GEMINI_API_KEY=

# AlloyDB / PostgreSQL Operational Database
ALLOYDB_HOST=localhost
ALLOYDB_PORT=5432
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=postgres
ALLOYDB_DB=decision_intel

# BigQuery Analytics Dataset
BQ_DATASET=smart_city_metrics

# Cloud Storage Bucket
GCS_BUCKET_NAME=smart-city-documents-bucket

# Security & CORS Settings
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
MAX_UPLOAD_SIZE_MB=10
